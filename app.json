{
  "expo": {
    "name": "LiveKit Voice",
    "slug": "expo-livekit-template",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "expolivekit",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/ExpoLiveKitIcon.icon",
      "bundleIdentifier": "com.example.expolivekit",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.example.expolivekit"
    },
    "plugins": [
      "expo-router",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Talk with your LiveKit voice assistant."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#000000",
    "web": {
      "output": "server",
      "favicon": "./assets/icon.png"
    }
  }
}
