{
  "expo": {
    "name": "LiveKit Voice",
    "slug": "expo-livekit-template",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "expolivekit",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/ExpoLiveKitIcon.icon",
      "bundleIdentifier": "dev.davidmokos.expolivekit",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.davidmokos.expolivekit"
    },
    "plugins": [
      "expo-router",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Talk with your LiveKit voice assistant.",
          "cameraPermission": "Share video with your LiveKit assistant."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080b0c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 64
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
