{
  "name": "expo-livekit-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/agent.ts dev",
    "start": "tsx src/agent.ts start",
    "api": "tsx src/api.ts",
    "fixture": "LIVEKIT_FIXTURE=1 tsx src/agent.ts dev",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx tests/transport-smoke.ts",
    "smoke:live": "SMOKE_MODE=live tsx tests/transport-smoke.ts",
    "smoke:audio": "tsx tests/audio-input-smoke.ts"
  },
  "dependencies": {
    "@livekit/agents": "1.9.5",
    "@livekit/agents-plugin-openai": "1.9.5",
    "@livekit/rtc-node": "1.2.1",
    "dotenv": "18.0.9",
    "livekit-server-sdk": "2.19.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
